---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/theme.css';

const REPO = 'https://github.com/zanaat-dev/baron';
const NPM = 'https://www.npmjs.com/package/@zanaat/baron-mcp-server';
const DOCS = '/docs/getting-started/';

const roles = ['backlog', 'ready', 'in_progress', 'in_review', 'done'];
// Azure is BeeMaster's real mapping; the others are Baron's example maps. A dash is a role that
// tracker leaves unmapped, which is a normal policy, not a gap.
const trackers = [
  { name: 'Azure DevOps', states: ['New', '—', 'Active', 'Test', 'Closed'] },
  { name: 'Jira', states: ['To Do', '—', 'In Progress', 'In Review', 'Done'] },
  { name: 'Linear', states: ['Backlog', '—', 'In Progress', 'Code Review', 'Done'] },
  { name: 'GitHub', states: ['open', '—', 'label: in-progress', 'label: in-review', 'closed'] },
];

const ports = [
  {
    port: 'issues',
    tools: ['baron_issue_read', 'baron_issue_write', 'baron_issue_move'],
    what: 'Create, update, link, assign, comment, move by role, block and unblock.',
  },
  {
    port: 'scm',
    tools: ['baron_scm_read', 'baron_scm_write'],
    what: 'Cut branches, open pull requests linked to the item, mark ready, merge.',
  },
  {
    port: 'ci',
    tools: ['baron_ci_read', 'baron_ci_run'],
    what: 'List pipelines and runs, read logs, trigger and cancel.',
  },
  {
    port: 'deploy',
    tools: ['baron_deploy_read'],
    what: 'Environments and what was deployed where.',
  },
  { port: 'notify', tools: ['baron_notify_send'], what: 'Post to a channel or a thread.' },
];

const providers = [
  { name: 'Azure DevOps', binds: 'issues · scm · ci · deploy' },
  { name: 'GitHub', binds: 'issues · scm · ci · deploy' },
  { name: 'Jira Cloud', binds: 'issues' },
  { name: 'Linear', binds: 'issues' },
  { name: 'Slack', binds: 'notify' },
];

const recipes = [
  { name: 'task-new', does: 'Files the item with its type and parent.' },
  {
    name: 'task-start',
    does: 'Cuts the canonical branch, moves the item to in_progress, assigns you.',
  },
  {
    name: 'task-finish',
    does: 'Opens a draft PR linked to the item, and warns if the link did not land.',
  },
  {
    name: 'task-land',
    does: 'Refuses red or pending checks, takes the PR out of draft, merges it.',
  },
];
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Baron: let your coding agent write to your work tracker</title>
    <meta name="description" content="Baron is an open-source layer that turns issues, branches, pull requests, CI runs and deployments into one contract, across Azure DevOps, GitHub, Jira, Linear and Slack." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <script is:inline>
      // Same storage key and resolution as Starlight, so the docs and this page agree on a theme.
      try {
        const stored = localStorage.getItem('starlight-theme');
        const theme = stored === 'light' || stored === 'dark'
          ? stored
          : matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <header class="top">
      <a class="brand" href="/" aria-label="Baron home">
        <span class="stops" aria-hidden="true"><i></i><i></i><b></b><i></i><i></i></span>
        baron
      </a>
      <nav aria-label="Primary">
        <a href={DOCS} data-key="d"><kbd>D</kbd> Docs</a>
        <a href={REPO} data-key="g"><kbd>G</kbd> GitHub</a>
        <a href={NPM} data-key="n"><kbd>N</kbd> npm</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow">Work orchestration for AI coding agents · Apache-2.0</p>
        <h1>Let your coding agent write to your work tracker.</h1>
        <p class="sub">
          One contract for issues, branches, pull requests, CI and deployments. Your agent speaks
          roles; Baron speaks Azure DevOps, GitHub, Jira, Linear and Slack, and keeps the flow when you
          change trackers.
        </p>
        <div class="cta">
          <div class="cmd">
            <code id="init-cmd">npx @zanaat/baron-cli init</code>
            <button type="button" class="copy" data-copy="init-cmd" aria-label="Copy the init command">Copy</button>
          </div>
          <a class="button" href={DOCS}>Read the docs</a>
        </div>
      </section>

      <figure class="rail" aria-labelledby="rail-cap">
        <div class="rail-head">
          <span class="fig">FIG. 1</span>
          <span id="rail-cap">One item, four trackers, one vocabulary.</span>
        </div>
        <div class="rail-scroll">
          <div class="rail-grid" style={`--cols: ${roles.length}`}>
            <span class="who">Baron role</span>
            {roles.map((role, i) => (
              <button type="button" class="role" data-col={i} aria-pressed={i === 2 ? 'true' : 'false'}>
                {role}
              </button>
            ))}
            {trackers.map((t) => (
              <>
                <span class="who">{t.name}</span>
                {t.states.map((s, i) => (
                  <span class:list={['native', { unmapped: s === '—', on: i === 2 }]} data-col={i}>{s}</span>
                ))}
              </>
            ))}
          </div>
        </div>
        <figcaption>
          The agent asks for a role; each tracker gets its own state. Pick a role to stop the walk. You
          confirm this mapping once with <code>baron init</code> and commit it with your repo, so the model
          never guesses it again. Azure shows a real team's mapping; the others are Baron's examples. A dash is a role
          that tracker leaves unmapped.
        </figcaption>
      </figure>

      <section class="band">
        <div class="band-head">
          <p class="eyebrow">Ports</p>
          <h2>Each capability binds to a provider on its own.</h2>
          <p>Issues on Azure DevOps, pull requests on GitHub and notifications on Slack is an ordinary setup, not a special case.</p>
        </div>
        <ul class="ports">
          {ports.map((p) => (
            <li>
              <span class="port">{p.port}</span>
              <p>{p.what}</p>
              <span class="tools">{p.tools.join('  ')}</span>
            </li>
          ))}
        </ul>
        <ul class="providers" aria-label="Supported providers">
          {providers.map((p) => (
            <li><b>{p.name}</b><span>{p.binds}</span></li>
          ))}
        </ul>
      </section>

      <section class="band">
        <div class="band-head">
          <p class="eyebrow">Capability gaps</p>
          <h2>When a tracker cannot do something, you hear about it.</h2>
          <p>Every gap is decided by a policy you set. None is dropped quietly.</p>
        </div>
        <div class="gaps">
          <article>
            <code>error</code>
            <p>Stop with an actionable message. A Kanban column the item cannot take is refused before anything is written.</p>
          </article>
          <article>
            <code>emulate:labels</code>
            <p>Synthesize it. GitHub has no native parent and child, so the hierarchy rides a <code>parent:&lt;id&gt;</code> label.</p>
          </article>
          <article>
            <code>degrade</code>
            <p>Skip it and log a warning. A sprint asked of a tracker without sprints is skipped, and the warning says so.</p>
          </article>
        </div>
      </section>

      <section class="band">
        <div class="band-head">
          <p class="eyebrow">Recipes</p>
          <h2>The daily loop is four calls.</h2>
          <p>Workflow opinion lives in declarative recipes, not in prompts and not in the core. Each runs as one journaled call, and a run that stops halfway resumes where it stopped.</p>
        </div>
        <ol class="recipes">
          {recipes.map((r) => (
            <li><code>{r.name}</code><span>{r.does}</span></li>
          ))}
        </ol>
        <figure class="demo">
          <img src="/demo/baron-demo.gif" width="910" height="595" loading="lazy" decoding="async" alt="A terminal recording of Baron running task-start and then task-finish against a real tracker." />
        </figure>
      </section>

      <section class="band install">
        <div class="band-head">
          <p class="eyebrow">Install</p>
          <h2>Two ways in.</h2>
        </div>
        <div class="paths">
          <article>
            <h3>Claude Code plugin</h3>
            <pre><code>/plugin marketplace add zanaat-dev/baron
/plugin install baron@baron</code></pre>
          </article>
          <article>
            <h3>Any MCP client</h3>
            <pre><code>npx -y @zanaat/baron-mcp-server@latest</code></pre>
            <p>Listed in the official MCP Registry as <code>io.github.zanaat-dev/baron</code>.</p>
          </article>
        </div>
      </section>
    </main>

    <footer class="foot">
      <span>Apache-2.0 · a <a href="https://zanaat.dev">zanaat</a> project</span>
      <span><a href={REPO}>GitHub</a> · <a href={NPM}>npm</a> · <a href="/llms.txt">llms.txt</a></span>
    </footer>

    <script>
      const roles = [...document.querySelectorAll<HTMLButtonElement>('.role')];
      const cells = [...document.querySelectorAll<HTMLElement>('.native')];
      let col = 2;
      let timer: number | undefined;

      function show(next: number) {
        col = next;
        for (const r of roles) r.setAttribute('aria-pressed', String(Number(r.dataset.col) === col));
        for (const c of cells) c.classList.toggle('on', Number(c.dataset.col) === col);
      }

      // The rail walks the roles on its own until someone picks one, unless motion is unwanted.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        timer = window.setInterval(() => show((col + 1) % roles.length), 2200);
      }
      for (const r of roles) {
        r.addEventListener('click', () => {
          window.clearInterval(timer);
          show(Number(r.dataset.col));
        });
      }

      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        button.addEventListener('click', async () => {
          const text = document.getElementById(button.dataset.copy ?? '')?.textContent ?? '';
          try {
            await navigator.clipboard.writeText(text);
            button.textContent = 'Copied';
          } catch {
            button.textContent = 'Select it';
          }
          window.setTimeout(() => (button.textContent = 'Copy'), 1600);
        });
      }

      document.addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const target = e.target as HTMLElement;
        if (target.closest('input, textarea, [contenteditable]')) return;
        const link = document.querySelector<HTMLAnchorElement>(`a[data-key="${e.key.toLowerCase()}"]`);
        if (link) link.click();
      });
    </script>

    <style is:global>
      * { box-sizing: border-box; }
      html { background: var(--baron-ink); }
      body {
        margin: 0;
        background: var(--baron-ink);
        color: var(--baron-text);
        font-family: var(--sl-font);
        font-size: 16px;
        line-height: 1.6;
      }
      a { color: var(--baron-signal); text-underline-offset: 3px; }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--baron-signal); outline-offset: 3px; }
      code, pre, kbd { font-family: var(--sl-font-mono); }
      h1, h2, h3 { margin: 0; }
      p { margin: 0; }
    </style>

    <style>
      .top, main, .foot { max-width: 1120px; margin-inline: auto; padding-inline: 20px; }
      .top {
        display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; justify-content: space-between;
        padding-block: 18px;
      }
      .brand {
        display: inline-flex; gap: 10px; align-items: center;
        font-family: var(--sl-font-mono); font-weight: 500; font-size: 1.1rem; color: var(--baron-text); text-decoration: none;
      }
      .stops { display: inline-flex; gap: 2px; align-items: center; }
      .stops i { width: 4px; height: 4px; border-radius: 1px; background: var(--baron-muted); opacity: 0.6; }
      .stops b { width: 5px; height: 12px; border-radius: 1.5px; background: var(--baron-signal); }
      nav { display: flex; flex-wrap: wrap; gap: 6px; }
      nav a {
        display: inline-flex; gap: 8px; align-items: center; padding: 6px 10px; border-radius: 6px;
        font-family: var(--sl-font-mono); font-size: 0.8rem; letter-spacing: 0.04em; text-transform: uppercase;
        color: var(--baron-text); text-decoration: none; background: var(--baron-surface); border: 1px solid var(--baron-line);
      }
      nav a:hover { border-color: var(--baron-signal); }
      kbd { font-size: 0.72rem; color: var(--baron-signal); }

      main { display: grid; gap: 88px; padding-block: 48px 96px; }
      .eyebrow {
        font-family: var(--sl-font-mono); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase;
        color: var(--baron-muted);
      }
      .hero { display: grid; gap: 22px; }
      .hero h1 {
        font-family: var(--baron-display); font-weight: 700; letter-spacing: -0.03em; line-height: 1.02;
        font-size: clamp(2.4rem, 7vw, 5.2rem); max-width: 14ch; text-wrap: balance;
      }
      .sub { font-size: clamp(1.05rem, 2vw, 1.25rem); color: var(--baron-muted); max-width: 60ch; }
      .cta { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
      .cmd {
        display: inline-flex; align-items: center; gap: 10px; padding: 8px 8px 8px 14px; border-radius: 8px;
        background: var(--baron-surface); border: 1px solid var(--baron-line); max-width: 100%;
      }
      .cmd code { font-size: 0.95rem; overflow-x: auto; white-space: nowrap; }
      .copy, .button {
        font: 500 0.85rem var(--sl-font-mono); padding: 8px 14px; border-radius: 6px; cursor: pointer; text-decoration: none;
      }
      .copy { background: transparent; color: var(--baron-text); border: 1px solid var(--baron-line); }
      .copy:hover { border-color: var(--baron-signal); }
      .button { background: var(--baron-signal); color: var(--baron-ink); border: 1px solid var(--baron-signal); }

      .rail { margin: 0; display: grid; gap: 14px; }
      .rail-head { display: flex; flex-wrap: wrap; gap: 12px; align-items: baseline; }
      .fig { font-family: var(--sl-font-mono); font-size: 0.75rem; letter-spacing: 0.08em; color: var(--baron-signal); }
      #rail-cap { font-family: var(--baron-display); font-size: 1.3rem; font-weight: 600; }
      .rail-scroll { overflow-x: auto; border: 1px solid var(--baron-line); border-radius: 12px; background: var(--baron-surface); }
      .rail-grid {
        display: grid; grid-template-columns: 130px repeat(var(--cols), minmax(132px, 1fr));
        gap: 8px; padding: 18px; min-width: 820px; align-items: center;
      }
      .who { font-family: var(--sl-font-mono); font-size: 0.8rem; color: var(--baron-muted); }
      .role, .native {
        font-family: var(--sl-font-mono); font-size: 0.85rem; text-align: center; padding: 9px 8px; border-radius: 7px;
        transition: background-color 0.35s, border-color 0.35s, color 0.35s;
      }
      .role {
        cursor: pointer; color: var(--baron-signal); background: var(--baron-signal-soft);
        border: 1px solid transparent; font-weight: 500;
      }
      .role[aria-pressed='true'] { background: var(--baron-signal); color: var(--baron-ink); }
      .native { color: var(--baron-muted); border: 1px dashed var(--baron-line); }
      .native.on { color: var(--baron-text); border: 1px solid var(--baron-signal); }
      .native.unmapped.on { border-style: dashed; color: var(--baron-muted); }
      .rail figcaption { color: var(--baron-muted); font-size: 0.95rem; max-width: 72ch; }
      @media (prefers-reduced-motion: reduce) {
        .role, .native { transition: none; }
      }

      .band { display: grid; gap: 28px; }
      .band-head { display: grid; gap: 10px; max-width: 70ch; }
      .band-head h2 { font-family: var(--baron-display); font-size: clamp(1.6rem, 3.4vw, 2.4rem); letter-spacing: -0.02em; line-height: 1.1; text-wrap: balance; }
      .band-head > p:last-child { color: var(--baron-muted); }

      .ports { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1px; background: var(--baron-line); border: 1px solid var(--baron-line); border-radius: 12px; overflow: hidden; }
      .ports li { background: var(--baron-ink); padding: 20px; display: grid; gap: 10px; align-content: start; min-width: 0; }
      .port { font-family: var(--sl-font-mono); color: var(--baron-signal); font-weight: 500; }
      .ports p { font-size: 0.95rem; }
      .tools { font-family: var(--sl-font-mono); font-size: 0.72rem; color: var(--baron-muted); word-break: break-word; }
      .providers { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
      .providers li { display: inline-flex; gap: 10px; align-items: baseline; padding: 8px 12px; border: 1px solid var(--baron-line); border-radius: 999px; }
      .providers span { font-family: var(--sl-font-mono); font-size: 0.75rem; color: var(--baron-muted); }

      .gaps { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
      .gaps article { display: grid; gap: 10px; align-content: start; padding-top: 14px; border-top: 2px solid var(--baron-line); }
      .gaps article > code { color: var(--baron-signal); font-size: 0.95rem; }
      .gaps p { color: var(--baron-muted); font-size: 0.95rem; }
      .gaps p code { color: var(--baron-text); font-size: 0.85em; }

      .recipes { margin: 0; padding: 0; list-style: none; counter-reset: step; display: grid; gap: 0; border-left: 2px solid var(--baron-line); }
      .recipes li { counter-increment: step; display: grid; grid-template-columns: 150px 1fr; gap: 16px; padding: 12px 0 12px 20px; position: relative; }
      .recipes li::before {
        content: counter(step); position: absolute; left: -11px; top: 14px; width: 20px; height: 20px; border-radius: 50%;
        background: var(--baron-ink); border: 2px solid var(--baron-signal); color: var(--baron-signal);
        font: 500 0.7rem/16px var(--sl-font-mono); text-align: center;
      }
      .recipes code { color: var(--baron-signal); }
      .recipes span { color: var(--baron-muted); }
      .demo { margin: 0; border: 1px solid var(--baron-line); border-radius: 12px; overflow: hidden; max-width: 910px; }
      .demo img { display: block; width: 100%; height: auto; }

      .paths { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
      .paths article { display: grid; gap: 12px; align-content: start; padding: 20px; border: 1px solid var(--baron-line); border-radius: 12px; background: var(--baron-surface); min-width: 0; }
      .paths h3 { font-family: var(--baron-display); font-size: 1.2rem; }
      .paths pre { margin: 0; overflow-x: auto; font-size: 0.85rem; line-height: 1.7; }
      .paths p { color: var(--baron-muted); font-size: 0.9rem; }

      .foot {
        display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between;
        padding-block: 28px 40px; border-top: 1px solid var(--baron-line);
        font-family: var(--sl-font-mono); font-size: 0.78rem; color: var(--baron-muted);
      }

      @media (max-width: 560px) {
        main { gap: 64px; }
        .recipes li { grid-template-columns: 1fr; gap: 4px; }
      }
    </style>
  </body>
</html>
