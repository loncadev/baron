{
  "name": "@zanaat/baron-adapter-jira",
  "version": "0.44.0",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["dist"],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zanaat/baron-core": "workspace:*"
  },
  "devDependencies": {
    "@zanaat/baron-conformance": "workspace:*",
    "@types/node": "^22.0.0"
  },
  "description": "Baron adapter for Jira Cloud: issues, with workflow-gated transitions and transition screens.",
  "keywords": ["baron", "ai-agents", "mcp", "work-orchestration", "devops", "jira", "adapter"],
  "author": "Baron contributors",
  "homepage": "https://github.com/zanaat-dev/baron#readme",
  "bugs": { "url": "https://github.com/zanaat-dev/baron/issues" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zanaat-dev/baron.git",
    "directory": "packages/adapters/jira"
