node_modules/
dist/
coverage/
*.tsbuildinfo
.DS_Store

# Editor/tooling caches. Biome reads .gitignore (vcs.useIgnoreFile), so ignoring these here also
# keeps machine-local scratch files out of the lint baseline.
.impeccable/

# The MCP registry's publisher binary. RELEASING now unpacks it outside the repository, but the
# name is ignored anyway: it is 20MB, and the tarball that carries it also carries a LICENSE and
# a README that would quietly replace this project's own.
mcp-publisher
mcp-publisher.exe

# Baron credentials are NEVER committed - policy is, secrets are not.
.baron/credentials
.baron/credentials.*
.env
.env.*
!.env.example

# Dogfood runs against a real project: the notes carry that project's internals (work-item ids,
# people's emails, org/repo names). They live here so the project under test never sees them, and
# they stay out of this public repo.
dogfood/
.baron/runs/
